# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Segredo para assinar a sessão do admin (texto aleatório com 32+ caracteres)
AUTH_SECRET=troque-por-um-texto-aleatorio-bem-grande

# Segredo usado pelo agendador (Vercel Cron / Supabase pg_cron) para enviar leads pendentes ao CRM
CRON_SECRET=troque-por-outro-texto-aleatorio

# Token da integração EVX CRM (Configurações > Integrações > Landing pages).
# Opcional: também pode ser colado no admin em Integrações. Se os dois existirem, vale o do admin.
EVX_CRM_TOKEN=

# URL pública do site
NEXT_PUBLIC_SITE_URL=https://www.ctformafit.com.br
